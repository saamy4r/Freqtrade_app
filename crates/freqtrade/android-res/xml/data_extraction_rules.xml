<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup rules. Nothing in this app is worth carrying to another
     device: the database holds cached trades that re-sync in seconds, and the
     credential key must not leave the phone it was generated on. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
